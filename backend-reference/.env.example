# Demo Mode works without the Supabase URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for Supabase email link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ElevenLabs: keep the API key server-side. Never prefix it with NEXT_PUBLIC_.
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
